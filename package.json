{
  "name": "mao-framework",
  "version": "0.1.0",
  "description": "Multi-Agent Orchestration Framework — Generate VS Code Copilot multi-agent dev environments from PRD + declarative config",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mao-scaffold": "./dist/bin/mao-scaffold.js",
    "mao-activate": "./dist/bin/mao-activate.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "scaffold": "tsx bin/mao-scaffold.ts",
    "activate": "tsx bin/mao-activate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src/ bin/ tests/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "copilot",
    "agents",
    "scaffold",
    "vscode",
    "multi-agent",
    "orchestration",
    "prd"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.2",
    "handlebars": "^4.7.8",
    "ora": "^8.1.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "@eslint/js": "^9.16.0",
    "typescript-eslint": "^8.18.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
