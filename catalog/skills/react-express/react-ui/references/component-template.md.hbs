# React Component Template

## Component Pattern

```tsx
interface {{pascal name}}CardProps {
  {{kebab name}}: {{pascal name}};
  onEdit?: (id: string) => void;
  onDelete?: (id: string) => void;
}

export function {{pascal name}}Card({ {{kebab name}}, onEdit, onDelete }: {{pascal name}}CardProps) {
